{
  "slug": "service-schedule",
  "display_name": "Service Schedule",
  "category": "policy",
  "form_type": "policy",
  "engine": "docxtemplater",
  "version": "1.0.0",
  "template_file": "template.docx",
  "pack": "participant_onboarding",
  "placeholders": [
    "org.abn",
    "org.branding.logo_path",
    "org.legal_name",
    "org.name",
    "participant.first_name",
    "participant.last_name",
    "participant.guardian_name"
  ],
  "required_signer_role": "participant",
  "signature_count": 2,
  "renewal_days": null,
  "is_active": true,
  "participant_service_types": [
    "all"
  ],
  "packs": [
    "participant_onboarding"
  ],
  "signing_layout": {
    "page_width": 595,
    "page_height": 842,
    "page_count": 3,
    "fields": [
      {
        "id": "org-signature",
        "page": 2,
        "x": 36,
        "y": 400,
        "width": 170,
        "height": 28,
        "type": "signature",
        "merge_key": "org_signature",
        "label": "Organisation signature",
        "signer": "org",
        "required": true
      },
      {
        "id": "client-signature",
        "page": 2,
        "x": 36,
        "y": 528,
        "width": 170,
        "height": 28,
        "type": "signature",
        "merge_key": "signature",
        "label": "Client signature",
        "signer": "participant",
        "applies_when": "participant",
        "required": true
      },
      {
        "id": "representative-signature",
        "page": 2,
        "x": 36,
        "y": 655,
        "width": 170,
        "height": 28,
        "type": "signature",
        "merge_key": "signature",
        "label": "Representative signature",
        "signer": "participant",
        "applies_when": "guardian",
        "required": true
      }
    ]
  },
  "admin_fields": [
    {
      "key": "signer_type",
      "label": "Who is completing and signing this document?",
      "type": "select",
      "options": ["participant", "guardian"],
      "required": true
    },
    {
      "key": "org_signature",
      "label": "Organisation signature (type full name to sign)",
      "type": "text",
      "required": true
    }
  ]
}
