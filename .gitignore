# Secrets and local config — never commit
.env
.env.local
.env.*.local
azure-email-function/local.settings.json

# Dependencies and build output
node_modules/
client/node_modules/
server/node_modules/
client/dist/

# Data (often contains PII)
data/
# But track source-code data directories (not runtime data)
!server/src/data/

# OS / editor
.DS_Store
*.log

# Local tooling / temp
.claude/
supabase/.temp/

# Pre-branding template backups (created by scripts/brandLibraryHeaders.mjs; local rollback only)
*.prebrand
__pycache__/
